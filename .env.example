# FarmWise Platform Environment Configuration Template
# Copy this file to .env and replace placeholder values before running locally or in production.

# Active Spring Boot Profile: dev | prod | test
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database
POSTGRES_DB=farmwise
POSTGRES_USER=farmwise
POSTGRES_PASSWORD=change-me-strong-local-password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/farmwise
SPRING_DATASOURCE_USERNAME=farmwise
SPRING_DATASOURCE_PASSWORD=change-me-strong-local-password

# Security & JWT (REQUIRED in production: minimum 32+ random characters)
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_ISSUER=farmwise-api

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8080

# Weather Integration (Open-Meteo works without an API key)
WEATHER_PROVIDER=open-meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1

# AI Agricultural Assistant (optional - leave empty for safe offline guidance mode)
AI_PROVIDER=none
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=

# Market Price Intelligence (optional - Agmarknet / eNAM adapter)
MARKET_DATA_PROVIDER=sample
AGMARKNET_API_URL=
AGMARKNET_API_KEY=

# Payment Gateway Abstraction (leave unconfigured until live gateway credentials are set)
PAYMENT_PROVIDER=unconfigured
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

# Email / SMTP & SMS Notifications (optional)
EMAIL_PROVIDER=log
SMTP_FROM=noreply@farmwise.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=log
SMS_API_KEY=

# Rate Limiting (requests per minute)
RATE_LIMIT_AUTH_RPM=20
RATE_LIMIT_API_RPM=120

# Maps & File Storage
MAPS_PROVIDER=open-meteo-geo
MAPS_API_KEY=
STORAGE_PROVIDER=s3
S3_BUCKET=farmwise-production-media
S3_REGION=auto
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-s3-access-key-id
S3_SECRET_KEY=your-s3-secret-access-key
S3_PUBLIC_BASE_URL=https://media.farmwise.ag
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Production Connection Pool Tuning (HikariCP)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
