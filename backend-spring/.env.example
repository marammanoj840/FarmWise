# FarmWise Spring Boot Backend Environment Template
# Copy to .env (never commit .env to Git)

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/farmwise
SPRING_DATASOURCE_USERNAME=farmwise
SPRING_DATASOURCE_PASSWORD=change-me-strong-local-password

# JWT Secret (required in prod: 32+ random characters; ephemeral secret used in dev if empty)
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Rate Limiting
RATE_LIMIT_AUTH_RPM=20
RATE_LIMIT_API_RPM=120

# Optional External Integration Keys
WEATHER_PROVIDER=open-meteo
AI_PROVIDER=none
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=
MARKET_DATA_PROVIDER=sample
AGMARKNET_API_KEY=
PAYMENT_PROVIDER=unconfigured
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@farmwise.ag
SMS_API_KEY=
MAPS_API_KEY=

# S3 / Cloudflare R2 File Storage
STORAGE_PROVIDER=s3
S3_BUCKET=farmwise-production-media
S3_REGION=auto
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=https://media.farmwise.ag
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Docker Compose PostgreSQL Initialization
POSTGRES_DB=farmwise
POSTGRES_USER=farmwise
POSTGRES_PASSWORD=change-me-strong-local-password
POSTGRES_PORT=5432
